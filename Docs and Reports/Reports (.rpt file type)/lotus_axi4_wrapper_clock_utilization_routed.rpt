# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y16 [get_cells u_core/u_rst_bufg]

# Location of IO Primitives which is load of clock spine

# Location of clock ports

# Clock net "u_core/rst_n_g" driven by instance "u_core/u_rst_bufg" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_u_core/rst_n_g}
add_cells_to_pblock [get_pblocks  {CLKAG_u_core/rst_n_g}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="u_core/rst_n_g"}]]]
resize_pblock [get_pblocks {CLKAG_u_core/rst_n_g}] -add {CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2 CLOCKREGION_X1Y3:CLOCKREGION_X1Y3}
#endgroup
